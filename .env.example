NODE_ENV=development
PORT=3000

# Postgres connection used by both the app (pg Pool) and drizzle-kit
DATABASE_URL=postgres://tdff:tdff@localhost:5432/tdff_dev

# 'dev': unverified x-user-id header (see dev-auth-verifier.ts).
# 'auth0': real JWT verification against Auth0's JWKS (see auth0-jwt-verifier.ts).
AUTH_MODE=dev

# Only required when AUTH_MODE=auth0 — see README's Auth0 setup section.
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_AUDIENCE=https://your-api-identifier
